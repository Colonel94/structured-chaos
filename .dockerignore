# Keep the build context small. The engine image needs only engine/ (source + pyproject)
# and scripts/ — NOT the venv, caches, data, node_modules, or docs. Without this the context
# ballooned to ~214 MB (it was shipping engine/.venv). Patterns are relative to the context
# root (deploy/Dockerfile builds with context = repo root).

.git
.gitignore

# Python envs / caches
**/.venv
.venv
**/__pycache__
**/*.py[cod]
**/.mypy_cache
**/.ruff_cache
**/.pytest_cache
**/*.egg-info

# Node / UI (engine image doesn't build the UI)
**/node_modules
ui/dist

# Local data, artifacts, model caches, secrets
data
artifacts
models
.cache
.env
.env.*

# Docs / planning / throwaway — not needed in the image
*.md
_parked
spike
