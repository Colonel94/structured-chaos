# ==========================================================================
# Adaptive Intake — environment template. Copy to `.env` and fill in.
# `.env` is gitignored (see .gitignore). NEVER commit real keys.
#
# Owner override 2026-08-10: the PoC LLM path is LOCAL on the RTX 4070 — NO API keys.
# Gate A (PREREQUISITES §9 / A4): local models load — faster-whisper transcribes a clip,
# Ollama returns a completion, BGE-M3 embeds, PaddleOCR reads an image.
# The cloud keys below are OPTIONAL and only for the deferred cloud backends.
# ==========================================================================

# --- Local model settings (PoC PRIMARY path — Gate A A4) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b            # extraction LLM on the 4070 (reasoning model: set think=false for extraction)
WHISPER_MODEL=large-v3           # faster-whisper ASR (GPU=CUDA12+cuDNN9, CPU fallback)
WHISPER_DEVICE=auto

# --- 1. Anthropic (DEFERRED cloud extraction backend — leave blank for the local PoC) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- 2. Cohere (DEFERRED cloud ASR backend — leave blank for the local PoC) ---
COHERE_API_KEY=

# --- 3. Meta WhatsApp Cloud API (dev test number — OPTIONAL; file/email drop is the day-one channel) ---
#   Full walkthrough: docs/WHATSAPP-SETUP.md. To go live receive+reply, also set CHANNEL_BACKEND=cloud.
#   Permanent System-User token (NOT the temporary 24h token), phone-number id, and
#   a verify-token string you invent for the webhook handshake.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
#   The tenant an inbound WhatsApp message is routed to (one number ↔ one tenant). Get it from
#   scripts/whatsapp_demo_setup.py.
WHATSAPP_TENANT_ID=
#   Flip egress from the $0 record-and-relay sink to live WhatsApp send. Leave `local` until the
#   credentials above are set; `cloud` makes the drill question actually go back to the customer.
CHANNEL_BACKEND=local

# --- 4. Public webhook (cloudflared/ngrok tunnel → local FastAPI) ---
#   Informational; the tunnel URL you register in the Meta app dashboard.
PUBLIC_WEBHOOK_URL=

# --- Backend switch (PREREQUISITES §4 / TECH-SPEC §0.1) ---
#   Each inference interface picks an impl: local | cloud | fake.
#   PoC runs all-LOCAL on the 4070 (owner override 2026-08-10); cloud impls are the
#   deferred path; tests use fake.
ASR_BACKEND=local
LLM_BACKEND=local
EMBEDDING_BACKEND=local
BLOB_BACKEND=local

# --- Postgres (docker-compose service) ---
#   TWO roles (EDD §7.1): the engine connects as the least-privilege app_rw (RLS-enforced);
#   migrations + role bootstrap run as the intake_admin superuser. A single superuser would
#   silently bypass RLS and make the tenant-isolation gate unprovable.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adaptive_intake
POSTGRES_USER=app_rw                       # runtime app role (created by migration 0001)
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_ADMIN_USER=intake_admin           # superuser — migrations only
POSTGRES_ADMIN_PASSWORD=change_me_admin_local

# --- MinIO (S3-compatible blob store; docker-compose service) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_local_only
MINIO_BUCKET=originals

# --- Embeddings (BGE-M3; self-hosted, CPU-capable) ---
BGE_MODEL=BAAI/bge-m3

# --- Customer portal (public /p surface — see PORTAL.md) ---
#   PORTAL_ENABLED gates the public routes (fail-closed). PORTAL_SECRET is the HMAC key for signed case
#   tokens — MUST be a real random value in prod (openssl rand -hex 32); the app refuses to boot in prod
#   with the PoC placeholder. Leave the local placeholder for dev.
PORTAL_ENABLED=false
PORTAL_SECRET=poc-portal-secret-2026

# --- Worker liveness (R3) ---
#   A worker heartbeats every ~15s; if the newest beat is older than this the worker reads as DOWN and
#   the portal shows honest handoff copy instead of an open-ended spinner. /health reports it too.
WORKER_LIVENESS_SECONDS=60

# --- Public edge / TLS (R6; only when deploying behind Caddy with a real domain) ---
#   A domain → Caddy gets a Let's Encrypt cert automatically. ":80" → plain HTTP (no-domain test).
#   Start it: docker compose --profile edge -f deploy/docker-compose.yml up -d caddy
SITE_ADDRESS=:80

# --- Ollama (deploy note, R1) ---
#   In a CONTAINER, OLLAMA_HOST is the CLIENT target (compose sets host.docker.internal). On a native
#   Linux host you must ALSO bind the Ollama SERVER to 0.0.0.0:11434 or the container can't reach it —
#   run scripts/preflight_ollama.py to check. See docs/DEPLOY.md §Ollama. (Same var name, opposite role.)

# --- App ---
#   APP_ENV=prod turns ON the fail-closed secret check (R5): the app refuses to start if any secret above
#   is still a change_me_* / poc placeholder. Generate real ones: openssl rand -hex 32
APP_ENV=dev
LOG_LEVEL=INFO
