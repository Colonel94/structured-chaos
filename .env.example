# ==========================================================================
# Adaptive Intake — environment template. Copy to `.env` and fill in.
# `.env` is gitignored (see .gitignore). NEVER commit real keys.
#
# Owner override 2026-08-10: the PoC LLM path is LOCAL on the RTX 4070 — NO API keys.
# Gate A (PREREQUISITES §9 / A4): local models load — faster-whisper transcribes a clip,
# Ollama returns a completion, BGE-M3 embeds, PaddleOCR reads an image.
# The cloud keys below are OPTIONAL and only for the deferred cloud backends.
# ==========================================================================

# --- Local model settings (PoC PRIMARY path — Gate A A4) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:14b            # extraction LLM on the 4070 (reasoning model: set think=false for extraction)
WHISPER_MODEL=large-v3           # faster-whisper ASR (GPU=CUDA12+cuDNN9, CPU fallback)
WHISPER_DEVICE=auto

# --- 1. Anthropic (DEFERRED cloud extraction backend — leave blank for the local PoC) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- 2. Cohere (DEFERRED cloud ASR backend — leave blank for the local PoC) ---
COHERE_API_KEY=

# --- 3. Meta WhatsApp Cloud API (dev test number — OPTIONAL; file/email drop is the day-one channel) ---
#   Permanent System-User token (NOT the temporary 24h token), phone-number id, and
#   a verify-token string you invent for the webhook handshake.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- 4. Public webhook (cloudflared/ngrok tunnel → local FastAPI) ---
#   Informational; the tunnel URL you register in the Meta app dashboard.
PUBLIC_WEBHOOK_URL=

# --- Backend switch (PREREQUISITES §4 / TECH-SPEC §0.1) ---
#   Each inference interface picks an impl: local | cloud | fake.
#   PoC runs all-LOCAL on the 4070 (owner override 2026-08-10); cloud impls are the
#   deferred path; tests use fake.
ASR_BACKEND=local
LLM_BACKEND=local
EMBEDDING_BACKEND=local
BLOB_BACKEND=local

# --- Postgres (docker-compose service) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adaptive_intake
POSTGRES_USER=app_rw
POSTGRES_PASSWORD=change_me_local_only

# --- MinIO (S3-compatible blob store; docker-compose service) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_local_only
MINIO_BUCKET=originals

# --- Embeddings (BGE-M3; self-hosted, CPU-capable) ---
BGE_MODEL=BAAI/bge-m3

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
